[Unit]
# Pushes every beads database that has a configured Dolt remote. Three rigs had a real
# private GitHub remote wired by make-beads-repo.sh and then nothing ever pushed again —
# all three last received data on 2026-09-02 within 36 seconds of each other, the
# signature of a one-shot setup script rather than a backup. A configured remote that
# nothing pushes answers "is this backed up?" with a yes it has not earned.
Description=Push beads Dolt databases to their configured remotes
Documentation=file://@SPIRA_REPO@/beads-push.sh
After=default.target

[Service]
Type=oneshot
ExecStart=@SPIRA_REPO@/beads-push.sh
TimeoutStartSec=3600
# This box also runs prod and the CI runner; a Dolt push is bursty and must never be the
# reason something user-facing gets slow (law-fence-loops-on-shared-hardware).
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
StandardOutput=append:@SPIRA_REPO@/.runtime/beads-push.log
StandardError=append:@SPIRA_REPO@/.runtime/beads-push.log

[Install]
WantedBy=default.target
