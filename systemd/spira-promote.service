[Unit]
Description=Spira promote — fast-forward the production checkout to the current dev HEAD
Documentation=file://@SPIRA_HOME@/promote.sh
After=default.target

[Service]
Type=oneshot
# @SPIRA_HOME@ is the dev checkout, not @SPIRA_PROD@. Running from the prod checkout would
# set SPIRA_REPO = prod checkout root and trigger the single-checkout detection in promote.sh
# (SPIRA_PROD is inside SPIRA_REPO when both are the prod checkout). The dev checkout gives
# SPIRA_REPO = dev root, SPIRA_PROD = prod checkout path — promote.sh proceeds correctly.
ExecStart=@SPIRA_HOME@/promote.sh main
TimeoutStartSec=120
CPUQuota=20%
Nice=10
StandardOutput=append:@SPIRA_RUN@/promote.log
StandardError=append:@SPIRA_RUN@/promote.log

[Install]
WantedBy=default.target
