[Unit]
Description=Spira suites — run the timed suite set the landing gate does not cover
Documentation=file://@SPIRA_HOME@/suites.sh

[Service]
Type=oneshot
ExecStart=@SPIRA_PROD@/suites.sh run
# CPU-fenced like every other loop on this box (law-fence-loops-on-shared-hardware).
CPUQuota=40%
Nice=10
# SPIRA_SUITES_MAXSEC is injected so suites.sh can cap its own budget under the timeout that
# will kill it. A config override of SPIRA_SUITES_BUDGET cannot then outrun this unit. Both
# numbers must be kept in sync; test-budget-drift.sh fails if they drift (sp-o060).
TimeoutStartSec=900
Environment=SPIRA_SUITES_MAXSEC=900
Environment=SPIRA_HOME=@SPIRA_PROD@
Environment=SPIRA_RUN=@SPIRA_RUN@
StandardOutput=append:@SPIRA_RUN@/suites.log
StandardError=append:@SPIRA_RUN@/suites.log

[Install]
WantedBy=default.target
