[Unit]
Description=Push beads Dolt remotes every six hours

[Timer]
# Offset from the JSONL mirror's 20-past-every-6-hours so the two backup jobs, which
# read the same databases, do not contend.
OnCalendar=*-*-* 03,09,15,21:50:00
Persistent=true
AccuracySec=5min
RandomizedDelaySec=300
Unit=beads-push.service

[Install]
WantedBy=timers.target
