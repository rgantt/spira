[Unit]
# Feeds the cockpit's health pane. Was started with nohup by layout.sh, which meant it
# died with the terminal and never came back after a reboot — and a collector that is
# gone renders every panel stale while the panes themselves look fine.
Description=Cockpit health collector (Gas Town snapshot + time series)
Documentation=file://@SPIRA_COCKPIT@/collect.sh
After=default.target

[Service]
Type=simple
ExecStart=@SPIRA_COCKPIT@/collect.sh loop
Restart=always
RestartSec=10
# One pass is ~27s of gt/bd probes; never let a slow probe look like a hang.
TimeoutStopSec=30
StandardOutput=append:@SPIRA_REPO@/.runtime/collect.log
StandardError=append:@SPIRA_REPO@/.runtime/collect.log

[Install]
WantedBy=default.target
