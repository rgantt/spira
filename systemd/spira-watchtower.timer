[Unit]
Description=Wake Ops on a timer and hand it the pipeline's vital signs

[Timer]
# TEN MINUTES, AND ops.fayth's FAYTH_TIMEOUT_SECONDS IS SET UNDER IT. The two numbers are a
# pair: a sweep that arrives faster than Ops can finish one queues snapshots behind a session
# already working a stale picture, and the first live sweep ran eighteen minutes against this
# ten. Change one and change the other. Short enough that a stall is noticed in minutes rather
# than the fifty it took on 2026-09-07.
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=30s
Unit=spira-watchtower.service

[Install]
WantedBy=timers.target
