[Unit]
Description=Advance the production checkout to the current dev HEAD every 2 minutes

[Timer]
# TWO MINUTES. The window between a commit landing in the dev checkout and the executing
# copy running it is at most one timer period. Two minutes matches the sentinel cadence
# and is short enough that a landed fix reaches production without operator intervention.
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=30s
Persistent=true
Unit=spira-promote.service

[Install]
WantedBy=timers.target
