[Unit]
Description=Check daily that every Spira suite still passes against the base ref

[Timer]
# DAILY, and that number is the promise the selection makes: a hole in the covers map is
# found within a day rather than never. More often would not find it sooner in any way that
# matters — the map changes when somebody edits it, not on a clock — and this is the most
# expensive periodic job here, so the cadence is set by what the guarantee needs and nothing
# else.
OnCalendar=daily
# A long window because nothing downstream waits on the answer, and because the useful time
# to run an hour of suites is whenever the box is otherwise quiet.
RandomizedDelaySec=3h
AccuracySec=15min
# It runs after a boot that missed its slot. A check that silently skips the days the box was
# off is one whose silence means nothing.
Persistent=true
Unit=spira-gate-full.service

[Install]
WantedBy=timers.target
