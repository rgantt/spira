[Unit]
# The QA persona's TIMER trigger. QA is not responding to an event — it sweeps the scar
# record on a cadence, looking for defects that escaped without a guarding assertion. There
# is no sweep bead: QA runs in beadless sweep mode (aeon.sh --sweep), which carries the
# same capacity and ledger accounting a builder does without the bead lifecycle.
#
# ExecCondition makes the unit inert until qa.fayth lands on main. Between arming the timer
# and the branch landing there is a window in which ExecStart would fail every six hours;
# an ExecCondition that exits non-zero makes systemd SKIP the pass and record success.
Description=Spira QA — sweep the scar record and propose test beads for unguarded defects
Documentation=file://@SPIRA_HOME@/chamber/qa.fayth
After=default.target

[Service]
Type=oneshot
ExecCondition=/usr/bin/test -f @SPIRA_PROD@/chamber/qa.fayth
ExecStart=@SPIRA_PROD@/aeon.sh qa --sweep
# FAYTH_TIMEOUT_SECONDS (3600) plus room for the sweep to start. An aeon that outlives this
# is killed, its lease goes stale, and the next pass starts clean on the next timer tick.
TimeoutStartSec=4200
# This box runs prod and the CI runner (law-fence-loops-on-shared-hardware). QA reads the
# scar record (file I/O and bd queries), not code; it need not outrun builders.
CPUQuota=30%
Nice=10
StandardOutput=append:@SPIRA_RUN@/qa.log
StandardError=append:@SPIRA_RUN@/qa.log

[Install]
WantedBy=default.target
