[Unit]
Description=Run the timed suite set on a schedule (sp-mfa4: nothing invoked suites.sh run)

[Timer]
# Hourly, per the operator's verdict on sp-rmnw: take the default action (install this
# timer) but no faster than hourly. Comfortably above SPIRA_SUITES_BUDGET (420s default),
# so one pass finishes well before the next is due.
OnBootSec=10min
OnUnitActiveSec=1h
AccuracySec=1min
Unit=spira-suites.service

[Install]
WantedBy=timers.target
