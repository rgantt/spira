#!/usr/bin/env bash
#
# pre-commit — the harness repository refuses to commit beads data.
#
# Armed by `exclude.sh install`, which sets core.hooksPath to this directory. That is why
# the hook is TRACKED rather than copied into .git/hooks: .git/hooks is not cloned, so a
# colleague would get the harness with its fence quietly missing. Tracked, it travels; one
# `git config` line arms it.
#
# All the judgement is in exclude.sh, so there is one implementation of the rule and the
# test suite exercises the thing that actually runs. Resolved relative to this file, so it
# works in a worktree and in a clone at any path.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
exec bash "$HERE/../exclude.sh" staged
